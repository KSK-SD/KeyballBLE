#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&key_repeat {
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        SSOID: SSOID {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N2 &kp N5 &kp N0 &kp N0 &kp N1 &kp N1 &kp N0 &kp N8 &kp N6>;
            label = "SSOID";
            tap-ms = <11>;
            wait-ms = <11>;
        };

        SSO_PASS: SSO_PASS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(K) &kp E &kp I &kp S &kp U &kp K &kp E &kp N0 &kp N7 &kp N1 &kp N7 &kp LS(G) &kp LS(E) &kp LS(H) &kp LS(C)>;
            label = "SSO_PASS";
            wait-ms = <11>;
            tap-ms = <11>;
        };

        toMac: toMac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&macro_wait_time 20>, <&tog 1>;

            label = "toMac";
        };

        toWin: toWin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&macro_wait_time 20>, <&tog 1>;

            label = "TOWIN";
        };

        bracket_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_BRACKET>,
                <&macro_wait_time 11>,
                <&kp RIGHT_BRACKET>,
                <&macro_wait_time 11>,
                <&kp LEFT>;

            label = "PAREN_PAIR";
        };

        parent_pair: parent_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_PARENTHESIS>,
                <&macro_wait_time 11>,
                <&kp RIGHT_PARENTHESIS>,
                <&macro_wait_time 11>,
                <&kp LEFT>;

            label = "PARENT_PAIR";
        };

        brace_pair: brace_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_BRACE>,
                <&macro_wait_time 11>,
                <&kp RIGHT_BRACE>,
                <&macro_wait_time 11>,
                <&kp LEFT>;

            label = "BRACE_PAIR";
        };
    };

    behaviors {
        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <15>;
        };

        bracket_bv: bracket_bv {
            compatible = "zmk,behavior-tap-dance";
            label = "bv_BRACKET";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&bracket_pair>, <&kp RIGHT_BRACKET>;

            tapping-term-ms = <150>;
        };

        parent_bv: parent_bv {
            compatible = "zmk,behavior-tap-dance";
            label = "PARENT_BV";
            #binding-cells = <0>;
            bindings =
                <&mt LEFT_SHIFT LEFT_PARENTHESIS>,
                <&parent_pair>,
                <&kp RIGHT_PARENTHESIS>;

            tapping-term-ms = <150>;
        };

        brace_bv: brace_bv {
            compatible = "zmk,behavior-tap-dance";
            label = "BRACE_BV";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp LEFT_BRACE>, <&brace_pair>, <&kp RIGHT_BRACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp L               &kp U           &kp F                   &kp LG(LS(NUMBER_4))                                    &none        &kp W              &lt 6 R          &kp Y                &kp P
&kp E  &mt LEFT_COMMAND I  &mt LEFT_ALT A  &mt LEFT_SHIFT O        &kp MINUS             &mkp LCLK      &kp RG(C)          &kp K        &mt RIGHT_SHIFT T  &mt RIGHT_ALT N  &mt RIGHT_COMMAND S  &kp H
&kp Z  &kp X               &kp C           &kp V                   &kp COMMA             &mkp RCLK      &kp RG(V)          &kp G        &kp D              &kp M            &kp J                &kp B
&none  &none               &kp DELETE      &mt LEFT_CONTROL SPACE  &lt 2 BACKSPACE       &lt 5 TAB      &kp RIGHT_CONTROL  &lt 3 ENTER                                                           &none
            >;

            sensor-bindings = <&ROTATE SCRL_UP SCRL_DOWN>;
        };

        layer_Windows_default {
            bindings = <
&kp Q   &kp L               &kp U           &kp F                   &kp LG(LS(S))                                      &none        &kp W              &lt 6 R          &kp Y                &kp P
&kp E   &mt LEFT_CONTROL I  &mt LEFT_ALT A  &mt LEFT_SHIFT O        &kp MINUS        &mkp LCLK      &kp RC(C)          &kp K        &mt RIGHT_SHIFT T  &mt RIGHT_ALT N  &mt RIGHT_CONTROL S  &kp H
&kp Z   &kp X               &kp C           &kp V                   &kp COMMA        &mkp RCLK      &kp RC(V)          &kp G        &kp D              &kp M            &kp J                &kp B
&SSOID  &SSO_PASS           &kp DELETE      &mt LEFT_COMMAND SPACE  &lt 2 BACKSPACE  &lt 5 TAB      &kp RIGHT_COMMAND  &lt 3 ENTER                                                           &none
            >;

            sensor-bindings = <&ROTATE SCRL_UP SCRL_DOWN>;
        };

        NUM_SYMBOL {
            bindings = <
&trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp TILDE                       &none           &kp LESS_THAN    &kp EQUAL     &kp GREATER_THAN  &kp PERCENT
&kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DOLLAR  &none       &none   &kp CARET       &kp PLUS         &kp MINUS     &kp ASTERISK      &kp SLASH
&trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PERIOD  &none       &trans  &kp UNDERSCORE  &kp EXCLAMATION  &kp QUESTION  &kp COLON         &kp SEMICOLON
&trans        &trans        &trans        &trans        &trans      &trans      &trans  &trans                                                           &none
            >;

            sensor-bindings = <&ROTATE SCRL_UP SCRL_DOWN>;
        };

        SYMBOL2_Ellipsis {
            bindings = <
&trans         &kp LEFT_BRACKET                   &kp DOUBLE_QUOTES          &bracket_bv  &kp AT_SIGN                        &none              &kp ESCAPE      &kp UP_ARROW    &kp CAPSLOCK     &none
&kp HASH       &mt LEFT_CONTROL LEFT_PARENTHESIS  &mt LEFT_ALT SINGLE_QUOTE  &parent_bv   &kp AMPERSAND  &trans      &none   &kp C_VOLUME_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp C_BRIGHTNESS_INC
&kp BACKSLASH  &kp LEFT_BRACE                     &kp GRAVE                  &brace_bv    &kp PIPE       &trans      &trans  &kp C_VOLUME_DOWN  &kp PAGE_UP     &none           &kp PAGE_DOWN    &kp C_BRIGHTNESS_DEC
&trans         &trans                             &trans                     &trans       &trans         &trans      &trans  &trans                                                              &none
            >;

            sensor-bindings = <&ROTATE SCRL_UP SCRL_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &mkp MB4  &trans  &trans  &trans  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &mkp LCLK      &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mkp RCLK      &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans                            &trans
            >;
        };

        Functions_BT {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3  &kp C_POWER                                  &toMac  &toWin  &bt BT_SEL 2  &none   &kp GLOBE
&kp F10  &kp F4  &kp F5  &kp F6  &trans           &trans      &studio_unlock  &trans  &trans  &trans        &trans  &trans
&trans   &kp F7  &kp F8  &kp F9  &kp C_AL_COFFEE  &trans      &bootloader     &trans  &trans  &trans        &trans  &none
&trans   &trans  &trans  &trans  &trans           &trans      &trans          &trans                                &none
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
